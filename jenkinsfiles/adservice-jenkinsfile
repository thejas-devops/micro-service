pipeline {
    agent any 

    environment {
        GIT_REPO_NAME = "micro-service"
        GIT_EMAIL = "thejas21081@gmail.com"
        GIT_USER_NAME = "thejas-devops"
        IMAGE_NAME = "adservice"
        REPO_URL = "968267516716.dkr.ecr.ap-south-1.amazonaws.com/adservice"
        YAML_FILE = "adservice.yaml"
        GIT_TOKAN = credentials('git-tokan')
    }

    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master', url: 'https://github.com/thejas-devops/micro-service.git'
            }
        }

        stage("Docker Image Build") {
            steps {
                script {
                    dir('src/adservice') {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t adservice .'
                    }
                }
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                    sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 968267516716.dkr.ecr.ap-south-1.amazonaws.com    
		docker tag adservice:latest 968267516716.dkr.ecr.ap-south-1.amazonaws.com/adservice:${BUILD_NUMBER}
                    docker push 968267516716.dkr.ecr.ap-south-1.amazonaws.com/adservice:${BUILD_NUMBER}
                    '''
                }
            }
        }

    stage('Update Deployment file') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'git-tokan', variable: 'git_token')]) {
                        sh '''
                            set -e
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"
                            echo "Build Number: ${BUILD_NUMBER}"

                            sed -i "s#image:.*#image: ${REPO_URL}:${BUILD_NUMBER}#" ${YAML_FILE}
                            git add ${YAML_FILE}
                            if ! git diff --cached --quiet; then
                                git commit -m "Update ${IMAGE_NAME} Image to version ${BUILD_NUMBER}"
                            else
                                echo "No changes to commit"
                            fi
                             git -c http.extraheader="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$git_tokan" | base64 | tr -d '\\n')" push origin HEAD:master
                        '''
                    }
                }
            }
        }
    }
}
